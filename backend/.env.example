# VOZX RideCompare Backend - Production Environment Variables Template
# Copy this file to .env for local development or configure these variables in Render / your hosting dashboard.

# Server Port (Render dynamically injects PORT)
PORT=5000

# Environment Mode: development | production | test
NODE_ENV=production

# Supabase PostgreSQL Database Connection Strings
# Pooled connection string (Transaction pooler, port 6543)
DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres?pgbouncer=true
# Direct connection string for Prisma migrations (Session mode, port 5432)
DIRECT_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:5432/postgres

# JWT Secret & Expiration
JWT_SECRET=your-secure-random-jwt-secret-minimum-32-characters
JWT_EXPIRES_IN=7d

# Allowed Frontend Origins for CORS (comma-separated if multiple)
# Local: http://localhost:5173
# Production: https://YOUR-FRONTEND-DOMAIN.vercel.app
FRONTEND_URL=http://localhost:5173

# Optional: Maps Provider API Key
MAPS_API_KEY=
